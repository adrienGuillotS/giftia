<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Platforms>AnyCPU;x64;x86</Platforms>
		<CorelInteropPath>C:\Program Files\Corel\CorelDRAW Graphics Suite 2019\Programs64\Assemblies\Corel.Interop.VGCore.dll</CorelInteropPath>
		<HasCorelInterop Condition="Exists('$(CorelInteropPath)')">true</HasCorelInterop>
		<HasCorelInterop Condition="'$(HasCorelInterop)'==''">false</HasCorelInterop>
		<DefineConstants>$(DefineConstants);HAS_COREL</DefineConstants>
		<DefineConstants Condition="'$(HasCorelInterop)'!='true'">$(DefineConstants.Replace(';HAS_COREL',''))</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="MahApps.Metro" Version="2.4.10" />
	  <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	  <PackageReference Include="System.Data.OleDb" Version="9.0.9" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="Corel.Interop.VGCore" Condition="'$(HasCorelInterop)'=='true'">
	    <HintPath>$(CorelInteropPath)</HintPath>
	  </Reference>
	</ItemGroup>

	<ItemGroup Condition="'$(HasCorelInterop)'!='true'">
	  <Compile Remove="Utilities\Corel\**\*.cs" />
	  <Compile Remove="Services\SvgImportService.cs" />
	  <Compile Remove="Interfaces\ISvgImportService.cs" />
	  <Compile Remove="Utilities\WrappingTextHelper.cs" />
	</ItemGroup>

</Project>
