<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<Platforms>AnyCPU;x64;x86</Platforms>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Resources\Amazon\CsvFiles\image_locations_for_cdr_file.csv" />
	  <None Remove="Resources\Amazon\CsvFiles\step_1_positions.csv" />
	  <None Remove="Resources\Amazon\CsvFiles\text_box_locations_for_svg_file.csv" />
	  <None Remove="symbol.svg" />
	  <None Remove="temu_symbol.svg" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="MahApps.Metro" Version="2.4.10" />
		<PackageReference Include="PDFsharp" Version="6.2.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\DesignerSuite.Core\DesignerSuite.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <Content Include="Resources\Amazon\CsvFiles\image_locations_for_cdr_file.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Resources\Amazon\CsvFiles\step_1_positions.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Resources\Amazon\CsvFiles\text_box_locations_for_svg_file.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Resources\Temu\CsvFiles\image_locations_for_cdr_file.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Resources\Temu\CsvFiles\step_1_positions.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Resources\Temu\CsvFiles\text_box_locations_for_svg_file.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="symbol.svg">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="temu_symbol.svg">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>
	<ItemGroup>
	  <Reference Include="Corel.Interop.VGCore">
	    <HintPath>C:\Program Files\Corel\CorelDRAW Graphics Suite 2019\Programs64\Assemblies\Corel.Interop.VGCore.dll</HintPath>
	    <Private>False</Private>
	    <EmbedInteropTypes>False</EmbedInteropTypes>
