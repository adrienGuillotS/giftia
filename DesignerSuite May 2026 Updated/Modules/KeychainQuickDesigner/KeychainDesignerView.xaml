<Page x:Class="KeychainQuickDesigner.Module.KeychainDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KeychainQuickDesigner.Module"
             mc:Ignorable="d" 
             Style="{DynamicResource PageStyle}"
             Title="Keychain Quick Designer"
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Import style from DesignerSuite.Core -->
                <ResourceDictionary Source="pack://application:,,,/DesignerSuite.Core;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Margin="6,6,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <!--<RowDefinition Height="auto"/>-->
            <!--<RowDefinition Height="*"/>-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <Label Content="Zip Files Source Folder" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Padding="0 10 10 2" FontSize="12"/>
        <TextBox x:Name="ZipsFolderPathTxt" Grid.Row="1" Grid.Column="0" Margin="0 0 4 0" VerticalContentAlignment="Stretch"/>
        <Button x:Name="ImagesBrowse" Content="Browse" Grid.Column="1" Grid.Row="1"
       Click="ImagesBrowse_Click" />

        <Label Content="'CDR' Files Destination Folder" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Padding="0 10 10 2" FontSize="12"/>
        <TextBox x:Name="CDRFilesLocationTxt" Grid.Row="3" Grid.Column="0"  Margin="0 0 4 0" VerticalContentAlignment="Stretch"/>
        <Button x:Name="CDRBrowse" Content="Browse" Grid.Column="1" Grid.Row="3"
       Click="CDRBrowse_Click" />
        <UniformGrid Columns="2" Grid.Row="5" Grid.Column="0" Margin="0 8" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <UniformGrid Rows="6" Margin="4 0 0 0" Columns="1">
                <Label Grid.Row="0" HorizontalAlignment="Stretch" 
                       HorizontalContentAlignment="Center" FontSize="18" 
                       Background="{DynamicResource MahApps.Brushes.AccentBase}">AMAZON</Label>

                <Button x:Name="PerformAmazonStepOneBtn" Content="Perform Step One" Margin="0 2"
                 HorizontalAlignment="Stretch" Grid.Row="0" 
                 Click="PerformAmazonStepOneBtn_Click" />
                <Button x:Name="PerformAmazonStepTwoButton" Content="Perform Step Two" Margin="0 2"
                    HorizontalAlignment="Stretch" Grid.Row="1" 
                    Click="PerformAmazonStepTwoButton_Click" />

                <Button x:Name="CopyAmazonMainImagesBtn" Content="Copy Main Images To Separate File" 
                     Margin="0 2" Grid.Row="2"
                    Click="CopyAmazonMainImagesBtn_Click"/>
                <Button x:Name="CopyAmazonTextBoxShapesButton" Content="Copy Text Box Shapes To Separate File" 
                      Margin="0 2" 
                    HorizontalAlignment="Stretch" Grid.Row="3"
                  Click="CopyAmazonTextBoxShapesButton_Click"/>
                <Button x:Name="EnlargeAmazonTextBoxShapesButton" Content="Enlarge Text Box Files" 
                     MinWidth="120" Margin="0 2"  
                    HorizontalAlignment="Stretch" Grid.Row="4"
                    Click="EnlargeAmazonTextBoxShapesButton_Click"/>
                <Button x:Name="ExportAmazonPdfButton" Content="Export To PDF" 
                     MinWidth="120" Margin="0 2" 
                    HorizontalAlignment="Stretch" Grid.Row="5"
                    Click="ExportAmazonPdfButton_Click"/>
            </UniformGrid>

            <!--Temu Buttons-->
            <UniformGrid Rows="6" Margin="4 0 0 0" Columns="1">
                <Label Grid.Row="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="18" Background="{DynamicResource MahApps.Brushes.AccentBase}">TEMU</Label>
                <Button x:Name="PerformTemuStepOneButton" Content="Perform Step One" Margin="0 2"
         HorizontalAlignment="Stretch" Grid.Row="1" 
         Click="PerformTemuStepOneButton_Click" />
                <Button x:Name="PerformTemuStepTwoButton" Content="Perform Step Two" Margin="0 2"
            HorizontalAlignment="Stretch" Grid.Row="2" 
            Click="PerformTemuStepTwoButton_Click" />

                <Button x:Name="CopyTemuMainImagesBtn" Content="Copy Main Images To Separate File" 
             Margin="0 2" Grid.Row="3"
            Click="CopyTemuMainImagesBtn_Click"/>
                <Button x:Name="CopyTemuTextBoxShapesButton" Content="Copy Text Box Shapes To Separate File" 
              Margin="0 2" 
            HorizontalAlignment="Stretch" Grid.Row="4"
          Click="CopyTemuTextBoxShapesButton_Click"/>
                <Button x:Name="EnlargeTemuTextBoxShapesButton" Content="Enlarge Text Box Files" 
             MinWidth="120" Margin="0 2"  
            HorizontalAlignment="Stretch" Grid.Row="5"
            Click="EnlargeTemuTextBoxShapesButton_Click"/>
                <Button x:Name="ExportTemuPdfButton" Content="Export To PDF" 
             MinWidth="120" Margin="0 2" 
            HorizontalAlignment="Stretch" Grid.Row="6"
            Click="ExportTemuPdfButton_Click"/>
            </UniformGrid>
        </UniformGrid>


        <mah:MetroProgressBar x:Name="Progress_Bar" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0 10"/>


        <!--<Label Content="Error Debug" Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2" Padding="0 10 10 2" FontSize="12"/>-->
        <!--<RichTextBox x:Name="ErrorDebugRichTxt" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Margin="0 0 0 0"/>-->
    </Grid>
</Page>
