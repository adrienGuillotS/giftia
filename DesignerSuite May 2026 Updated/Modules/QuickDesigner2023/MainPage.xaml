<Page x:Class="QuickDesinger2023.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuickDesinger2023"
      xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="400"
      Style="{DynamicResource PageStyle}"
      Title="Quick Designer 2023"
             Loaded="UserControl_Loaded">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Import style from DesignerSuite.Core -->
                <ResourceDictionary Source="pack://application:,,,/DesignerSuite.Core;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Margin="6,6,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <Label Content="Zip Files Source Folder" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Padding="0 10 10 2" FontSize="12"/>
        <TextBox x:Name="ZipsFolderPathTxt" Grid.Row="1" Grid.Column="0" Margin="0 0 4 0" VerticalContentAlignment="Stretch"/>
        <Button x:Name="ImagesBrowse" Content="Browse" Grid.Column="1" Grid.Row="1"
        Click="ImagesBrowse_Click"/>

        <Label Content="'CDR' Files Destination Folder" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Padding="0 10 10 2" FontSize="12"/>
        <TextBox x:Name="CDRFilesLocationTxt" Grid.Row="3" Grid.Column="0"  Margin="0 0 4 0" VerticalContentAlignment="Stretch"/>
        <Button x:Name="CDRBrowse" Content="Browse" Grid.Column="2" Grid.Row="3"
                Click="CDRBrowse_Click"/>


        <!--<Button x:Name="GenerateBtn" Margin="0 4 0 0" Content="Generate" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                Click="GenerateBtn_Click" MinWidth="100"/>-->
        <UniformGrid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 4 0 0"
             HorizontalAlignment="Stretch" VerticalAlignment="Center" Columns="2" Rows="1">
            <Button x:Name="GenerateBtn" Content="Generate (Amazon)" 
     Style="{StaticResource MahApps.Styles.Button}"
        Click="GenerateBtn_Click"/>
            <Button x:Name="GenerateTemuBtn" Content="Generate (Temu)"
        Style="{StaticResource MahApps.Styles.Button}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
            Click="GenerateTemuBtn_Click"/>
        </UniformGrid>

        <UniformGrid Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" 
        HorizontalAlignment="Stretch" VerticalAlignment="Top" Columns="2" >
            <Button x:Name="SortZipFilesBtn"
     Content="Move Amazon Zip Files" 
     ToolTip="Move the zip files to relevant sub folders arranged by date" 
     Margin="0 4" VerticalAlignment="Center"
         Click="MoveZipFilesBtn_Click"/>
            <Button x:Name="moveTemuZipFilesBtn"
     Content="Move Temu Zip Files" VerticalAlignment="Center"
     ToolTip="Move the zip files to relevant sub folders arranged by date" 
     Margin="0 4"
         Click="MoveTemuZipFilesBtn_Click"/>

        </UniformGrid>


        <mah:MetroProgressBar x:Name="Progress_Bar" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                     HorizontalAlignment="Stretch" VerticalAlignment="Top"
                     />


        <Label Content="Error Console" Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2" Padding="0 10 10 2" FontSize="12"/>
        <RichTextBox x:Name="ErrorConsoleRichTxt" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 0 0 0"/>
    </Grid>
</Page>
