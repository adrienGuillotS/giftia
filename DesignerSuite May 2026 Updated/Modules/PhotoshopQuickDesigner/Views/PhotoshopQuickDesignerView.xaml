<Page
    x:Class="PSQuickDesigner.Views.PhotoshopQuickDesignerView"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:enums="clr-namespace:PSQuickDesigner.Enums"
        xmlns:convertors="clr-namespace:PSQuickDesigner.Converters"
        mc:Ignorable="d"
        Title="Photoshop Quick Designer"
        Style="{DynamicResource PageStyle}"
        d:DesignHeight="450" d:DesignWidth="800" Loaded="Window_Loaded">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Import style from DesignerSuite.Core -->
                <ResourceDictionary Source="pack://application:,,,/DesignerSuite.Core;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convertors:EnumToBooleanConverter x:Key="enumToBooleanConverter"/>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2 0 2 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="Small Image Width" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBox x:Name="SmallImageWidthTB" Text="{Binding SmallImageWidth, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10 0 0 0">
                <TextBlock Text="Height" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBox x:Name="SmallImageHeightTB" Text="{Binding SmallImageHeight, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Grid.Row="1" Width="100" Margin="4,0,0,4"
                       Height="{Binding ElementName=SmallImageHeightTB, Path=Height}">
                <TextBlock Visibility="Visible" Text="" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Label  Content="{Binding SelectedUnit.Name, FallbackValue='Centimeter'}" VerticalAlignment="Center" IsEnabled="False" HorizontalContentAlignment="Left"
                   Background="{Binding ElementName=UnitsCB, Path=Background}" 
                   BorderBrush="{Binding ElementName=UnitsCB, Path=BorderBrush}" 
                   BorderThickness ="{Binding ElementName=UnitsCB, Path=BorderThickness}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0 5 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Source Zip Files" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"   HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <TextBox x:Name="ZipFolderPathCB" Grid.Row="1" Grid.Column="0"></TextBox>
            <Button x:Name="BrowseBtn" Content="..." ToolTip="Browse Zip Files" 
                    Grid.Row="1" Grid.Column="1" Margin="4 0 0 0" Padding="10 0 10 0" 
                    VerticalAlignment="Center" HorizontalAlignment="Stretch"  
                    Click="Button_Click"></Button>
            <UniformGrid Columns="2" Margin="0 10" 
                    Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  >
                <Button x:Name="AutomateAmazonBtn" Content="Automate (Amazon)" 
                      
                    Click="AutomateAmazonBtn_Click"></Button>
                <Button x:Name="AutomateTemuBtn" Content="Automate (Temu)" 
                    
                    Click="AutomateTemuBtn_Click"></Button>
            </UniformGrid>
        </Grid>

        <Expander x:Name="presetExpander" Grid.Row="2" Header="PRESET DETAILS" IsExpanded="True" ExpandDirection="Down"
                  Margin="0 10 0 0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="0 10 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1" Margin="2 0 2 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"  Text="SAVED BLANK DOCUMENT PRESETS" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <ComboBox x:Name="SavedPresetsCB" Grid.Row="1" Grid.Column="0"
                                  DisplayMemberPath="Name"  
                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                  ItemsSource="{Binding Presets, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="SavedPresetsCB_SelectionChanged"/>

                        <Button x:Name="CreateNewPresetBtn" Grid.Column="1" Grid.Row="1" Margin="10 0 0 0" Content="CREATE NEW PRESET"
                                Click="CreateNewPresetBtn_Click"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="2 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="2"  Margin="0 10 0 2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="AUTO"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"  Text="Width" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBox x:Name="WidthTB" Text="{Binding Path=SelectedPreset.Width, StringFormat=N3, Mode=TwoWay, FallbackValue='39', NotifyOnValidationError=True,ValidatesOnExceptions=True}"  Width="60" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" />
                            <ComboBox x:Name="UnitsCB" Grid.Row="1" Grid.Column="1" Margin="10 0 0 0" 
                                    SelectedItem="{Binding SelectedUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Units, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                            </ComboBox>
                            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"  Margin="10 0 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="AUTO"/>
                                    <ColumnDefinition Width="auto" MinWidth="140"/>
                                    <ColumnDefinition Width="AUTO"/>
                                    <ColumnDefinition Width="AUTO"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Height" Grid.Row="0"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBox x:Name="HeightTB" Text="{Binding Path=SelectedPreset.Height, StringFormat=N3, FallbackValue='39', Mode=TwoWay, NotifyOnValidationError=True,ValidatesOnExceptions=True}"  Grid.Row="1" Grid.Column="0" Width="60" HorizontalAlignment="Left" />

                                <TextBlock Text="Resolution" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="10 0 0 0"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBox Text="{Binding Path=SelectedPreset.Resolution, Mode=TwoWay,FallbackValue='300',StringFormat=N2, NotifyOnValidationError=True,ValidatesOnExceptions=True}"  Grid.Row="1" Grid.Column="0" Width="60" HorizontalAlignment="Left" />
                                <ComboBox x:Name="ResolutionUnitsCB" Grid.Row="1" Grid.Column="1" Margin="10 0 0 0" 
                                     SelectedItem="{Binding SelectedResolutionUnit, Mode=TwoWay}"
                                     DisplayMemberPath="Name"
                                     ItemsSource="{Binding ResolutionUnits}"/>


                                <TextBlock Text="Orietation" Grid.Row="0" Grid.Column="3" Margin="10 0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <StackPanel Grid.Row="1" Grid.Column="3" Margin="10 0" Orientation="Horizontal">
                                    <RadioButton x:Name="PortraitRB" VerticalAlignment="Stretch" VerticalContentAlignment="Center" BorderThickness="0" Padding="8 4"
                                                 IsChecked="{Binding Path=SelectedOrientation, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay,Converter={StaticResource enumToBooleanConverter}, ConverterParameter={x:Static enums:Orientation.Portrait }}">Portrait</RadioButton>
                                    <RadioButton VerticalAlignment="Stretch" Margin="10 0 0 0" VerticalContentAlignment="Center" BorderThickness="0" Padding="8 4"
                                                 IsChecked="{Binding Path=SelectedOrientation, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource enumToBooleanConverter}, ConverterParameter={x:Static enums:Orientation.Landscape}}">Landscape</RadioButton>

                                </StackPanel>

                                <TextBlock Text="Artboards" Grid.Row="0" Grid.Column="4" Margin="10 0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <CheckBox x:Name="ArtboardChB"  Grid.Row="1" Grid.Column="4" Margin="10 0" VerticalAlignment="Center"/>

                            </Grid>
                        </Grid>

                        <Grid Grid.Row="4"  Margin="0 6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="AUTO"/>
                                <ColumnDefinition Width="AUTO"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"  Margin="0 0 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Color Mode" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <ComboBox x:Name="ColorModeCB" Grid.Row="1" Grid.Column="0" 
            SelectedItem="{Binding SelectedColorMode, Mode=TwoWay}"
            DisplayMemberPath="Name"
            ItemsSource="{Binding ColorModes}"/>
                                <ComboBox x:Name="DepthCB" Grid.Row="1" Grid.Column="1" Margin="10 0 0 0" HorizontalAlignment="Stretch"
            SelectedItem="{Binding SelectedDepth, Mode=TwoWay}"
            DisplayMemberPath="Name"
            ItemsSource="{Binding Depths}">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>

                            </Grid>

                        </Grid>


                        <Grid Grid.Row="6"  Margin="0 6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Background Contents" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <ComboBox x:Name="FillCB"  Grid.Row="1" Grid.Column="0" Margin="0 0 0 0" 
                             SelectedItem="{Binding SelectedFillColor, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             ItemsSource="{Binding FillColors}" />


                            <TextBlock Text="Pixel Aspect Ratio" Grid.Row="0" Grid.Column="1" Margin="10 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <ComboBox x:Name="ScaleCB" Grid.Row="1" Grid.Column="1" Margin="10 0 0 0"   
                                        SelectedItem="{Binding SelectedPixelAspectRatio, Mode=TwoWay}"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding PixelAspectRatios}"/>
                        </Grid>

                        <Grid Grid.Row="7"  Margin="0 6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="AUTO"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Color Profile" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <ComboBox x:Name="ProfileCB" Grid.Row="1" Grid.Column="0" Margin="0 0 0 0"  
                                      SelectedItem="{Binding SelectedColorProfile, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding ColorProfiles}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Expander>
    </Grid>
</Page>
