<mah:MetroWindow x:Class="BirthdayCertificateDesigner2023.BirthDateErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BirthdayCertificateDesigner2023"
        mc:Ignorable="d" ResizeMode="NoResize"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        WindowStartupLocation="CenterOwner"
        GlowBrush="{DynamicResource MahApps.Brushes.AccentBase}"
        WindowTransitionsEnabled="True"
        Title="Invalid Date Time Format" Height="190" Width="420" Loaded="Window_Loaded">
    <mah:MetroWindow.Resources>
        <ResourceDictionary Source="/DesignerSuite.Core;component/Themes/PageStyles.xaml" />
    </mah:MetroWindow.Resources>
    <Grid Margin="10 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="InvalidDateCaptionTextBlock" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Margin="0,20,0,15" FontWeight="Bold" Text="DATE OF BIRTH IS INVALID" />

        <TextBox x:Name="InvalidDateTextBox" Grid.Row="1" Foreground="Red" BorderBrush="Red" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="30" IsReadOnly="True" Text="Your Invalid Date" />

        <DatePicker x:Name="DateControl" Grid.Row="2" HorizontalAlignment="Stretch" SelectedDateChanged="DateControl_SelectedDateChanged"
                VerticalAlignment="Top" Style="{StaticResource MahApps.Styles.DatePicker}">

        </DatePicker>
        <Grid Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="IgnoreBtn" Grid.Column="0" Content="Ignore" Margin="0 0 2 0"
                    Click="IgnoreBtn_Click"/>
            <Button x:Name="ContinueBtn" Grid.Column="1" Content="Continue" Margin="2 0"
                    Click="ContinueBtn_Click"/>
            <Button x:Name="SaveAndContinueBtn" Grid.Column="2" Content="Save and Continue"  Margin="2 0 0 0"
                    Click="SaveAndContinueBtn_Click"/>
        </Grid>
    </Grid>
</mah:MetroWindow>
