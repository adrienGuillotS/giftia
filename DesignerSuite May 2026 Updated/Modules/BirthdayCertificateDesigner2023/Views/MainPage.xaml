<Page x:Class="BirthdayCertificateDesigner2023.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:BirthdayCertificateDesigner2023"
    mc:Ignorable="d" 
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    d:DesignHeight="500" d:DesignWidth="400"
    Style="{DynamicResource PageStyle}"
    Title="Birthday Certificate Designer 2023"
    Loaded="UserControl_Loaded">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Import style from DesignerSuite.Core -->
                <ResourceDictionary Source="pack://application:,,,/DesignerSuite.Core;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <mah:MetroTabControl>
        <mah:MetroTabItem Header="Zip Orders">
            <Grid Margin="6,6,6,6" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto" MinWidth="100"/>
                </Grid.ColumnDefinitions>

                <Label Content="Zip Files Source Folder" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Padding="0 10 10 2" FontSize="12"/>
                <TextBox x:Name="ZipsFolderPathTxt" Grid.Row="1" Grid.Column="0" Margin="0 0 4 0" VerticalContentAlignment="Stretch"/>
                <Button x:Name="ImagesBrowse" Content="Browse" Grid.Column="1" Grid.Row="1"
         Click="ImagesBrowse_Click"/>

                <Label Content="'CDR' Files Destination Folder" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Padding="0 10 10 2" FontSize="12"/>
                <TextBox x:Name="CDRFilesLocationTxt" Grid.Row="3" Grid.Column="0" Margin="0 0 4 0" VerticalContentAlignment="Stretch"/>
                <Button x:Name="BrowseBtn" Content="Browse" Grid.Column="1" Grid.Row="3"
         Click="CDRBrowse_Click"/>

                <UniformGrid Columns="2" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
         HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button x:Name="GenerateAmazonBtn" Content="Generate (Amazon)" 
 Click="GenerateAmazonBtn_Click"/>
                    <Button x:Name="GenerateTemuBtn" Content="Generate (Temu)" 
 Click="GenerateTemuBtn_Click"/>
                </UniformGrid>




                <mah:MetroProgressBar x:Name="Progress_Bar" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
              HorizontalAlignment="Stretch" VerticalAlignment="Center"/>


                <Label Style="{StaticResource MahApps.Styles.Label}" Content="Error Console" Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2" Padding="0 10 10 2" FontSize="12"/>
                <RichTextBox x:Name="ErrorConsoleRichTxt" VerticalScrollBarVisibility="Auto" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 0 0 0"/>
            </Grid>
        </mah:MetroTabItem>
        <mah:MetroTabItem Header="Manual Orders">
            <Grid Margin="6,6,6,6" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto" MinWidth="100"/>
                </Grid.ColumnDefinitions>

                <!-- MOVED TO TOP -->
                <Label Content="'CDR' Files Destination Folder"
           Grid.Column="0"
           Grid.Row="0"
           Grid.ColumnSpan="2"
           Padding="0 10 10 2"
           FontSize="12"/>

                <TextBox x:Name="ManuallyDesignedCDRFileLocationTxt"
             Grid.Row="1"
             Grid.Column="0"
             Margin="0 0 4 0"
             VerticalContentAlignment="Stretch"/>

                <Button x:Name="CDRBrowseBtn"
            Content="Browse"
            Grid.Column="1"
            Grid.Row="1"
            Click="CDRBrowseBtn_Click"/>

                <!-- FILE NAME -->
                <Label Content="File Name"
           Grid.Column="0"
           Grid.Row="2"
           Grid.ColumnSpan="2"
           Padding="0 10 10 2"
           FontSize="12"/>

                <TextBox x:Name="FileNameTxt"
             Grid.Row="3"
             Grid.Column="0"
             Grid.ColumnSpan="2"
             VerticalContentAlignment="Stretch"/>

                <!-- PERSON NAME -->
                <Label Content="Person Name"
           Grid.Row="4"
           Grid.ColumnSpan="2"
           Padding="0 10 10 2"
           FontSize="12"/>

                <TextBox x:Name="PersonNameTxt"
             Grid.Row="5" Grid.ColumnSpan="2"
             Grid.Column="0"
             VerticalContentAlignment="Stretch"/>

                <!-- DATE OF BIRTH -->
                <Label Content="Date Of Birth"
           Grid.Row="6"
           Grid.ColumnSpan="2"
           Padding="0 10 10 2"
           FontSize="12"/>

                <mah:DateTimePicker x:Name="DateOfBirthTxt"
                        Grid.Row="7"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        VerticalContentAlignment="Stretch"/>

                <!-- CITY -->
                <Label Content="City"
           Grid.Column="0"
           Grid.Row="8"
           Grid.ColumnSpan="2"
           Padding="0 10 10 2"
           FontSize="12"/>

                <TextBox x:Name="CityTxt"
             Grid.Row="9"
             Grid.Column="0"
             Grid.ColumnSpan="2"
             VerticalContentAlignment="Stretch"/>

                <Button x:Name="GenerateManualCertificateBtn" Margin="0 10 0 0" Grid.Row="10" Grid.ColumnSpan="2" Content="Generate" 
            Click="GenerateManualCertificateBtn_Click"/>


                <Label Style="{StaticResource MahApps.Styles.Label}" Content="Status" Grid.Column="0" Grid.Row="11" Grid.ColumnSpan="2" Padding="0 10 10 2" FontSize="12"/>
                <RichTextBox x:Name="ErrorConsoleManualTabRichTxt" VerticalScrollBarVisibility="Auto" Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 0 0 0"/>

            </Grid>
        </mah:MetroTabItem>
    </mah:MetroTabControl>
</Page>
