      <setting name="IgnoredSize"        serializeAs="String"><value>400*400</value></setting>
      <setting name="IgnoredWords"       serializeAs="String"><value>preview</value></setting>
      <setting name="BatchSize"          serializeAs="String"><value>50</value></setting>
